# Interface web do LicitaBot (licitações + resultados).
#
# Instalar:
#   sudo cp licitabot/scripts/licitabot-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now licitabot-web
#
# Acesso local  : http://127.0.0.1:8081
# Acesso tailnet: http://<ip-tailscale>:8081
# Para expor na rede, troque --host para 0.0.0.0 E COLOQUE AUTENTICAÇÃO na
# frente (nginx/caddy). A base tem dado comercial; não exponha aberto.

[Unit]
Description=LicitaBot — interface web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/licitacoes
Environment=HOME=/root
# PYTHONUNBUFFERED importa: sem ele o log só aparece quando o buffer enche,
# e um serviço que "não loga nada" é impossível de depurar.
Environment=PYTHONUNBUFFERED=1
# Escuta em 0.0.0.0 mas a ACL interna do app só libera localhost e o
# tailnet (100.x). Isso permite abrir a interface pela rede privada
# sem expor para a internet.
ExecStart=/usr/bin/python3 -m licitabot.cli web --host 0.0.0.0 --porta 8081
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# ENDURECIMENTO — com uma ressalva importante.
# `ProtectSystem=full` e `ProtectHome` deixam /root inacessível. Como o
# repositório costuma ficar em /root/licitacoes, o serviço morre sem log
# nenhum (foi exatamente o que aconteceu no primeiro deploy). Por isso
# ProtectHome=false aqui. Se você mover o projeto para /opt, pode remover
# esta linha e ganhar o endurecimento completo.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false

[Install]
WantedBy=multi-user.target
